{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm install",

  "headers": [
    {
      "source": "/puzzles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
